[
  {
    "name": "theme_info",
    "theme_name": "Kiln",
    "theme_author": "Kiln Team",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://support.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_clay_bg",
        "label": "Clay background",
        "default": "#EBE5DF"
      },
      {
        "type": "color",
        "id": "color_clay_text",
        "label": "Clay foreground",
        "default": "#2A2522"
      },
      {
        "type": "color",
        "id": "color_linen_bg",
        "label": "Linen background",
        "default": "#FAFAFA"
      },
      {
        "type": "color",
        "id": "color_linen_text",
        "label": "Linen foreground",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_ash_bg",
        "label": "Ash background",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_ash_text",
        "label": "Ash foreground",
        "default": "#F5F5F5"
      },
      {
        "type": "color",
        "id": "color_sage_bg",
        "label": "Sage background",
        "default": "#E3E8E1"
      },
      {
        "type": "color",
        "id": "color_sage_text",
        "label": "Sage foreground",
        "default": "#202B1D"
      },
      {
        "type": "select",
        "id": "default_color_scheme",
        "label": "Default color scheme",
        "options": [
          {
            "value": "clay",
            "label": "Clay"
          },
          {
            "value": "linen",
            "label": "Linen"
          },
          {
            "value": "ash",
            "label": "Ash"
          },
          {
            "value": "sage",
            "label": "Sage"
          }
        ],
        "default": "linen"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "work_sans_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "work_sans_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "default": 1200,
        "unit": "px",
        "label": "Page width"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 20,
        "max": 100,
        "step": 4,
        "default": 40,
        "unit": "px",
        "label": "Section spacing"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          },
          {
            "value": "modal",
            "label": "Modal"
          }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable animations",
        "default": true
      },
      {
        "type": "select",
        "id": "animation_effect",
        "label": "Animation style",
        "options": [
          {
            "value": "slide-up",
            "label": "Slide up"
          },
          {
            "value": "fade",
            "label": "Fade in"
          },
          {
            "value": "zoom-in",
            "label": "Zoom in"
          },
          {
            "value": "slide-sides",
            "label": "Slide in from sides"
          }
        ],
        "default": "slide-up"
      },
      {
        "type": "select",
        "id": "animation_speed",
        "label": "Animation speed",
        "options": [
          {
            "value": "fast",
            "label": "Snappy (0.4s)"
          },
          {
            "value": "medium",
            "label": "Fluid (0.8s)"
          },
          {
            "value": "slow",
            "label": "Slow (1.2s)"
          }
        ],
        "default": "medium"
      }
    ]
  }
]
