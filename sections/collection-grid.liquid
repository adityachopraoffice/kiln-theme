<div class="collection-grid color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="collection-grid__header">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="h5">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-grid__items {% if section.settings.card_style == 'asymmetric' %}collection-grid__items--asymmetric{% endif %}">
      {%- for block in section.blocks -%}
        <div class="collection-grid__item" {{ block.shopify_attributes }}>
          {%- assign collection = collections[block.settings.collection] -%}
          <a href="{% if collection == empty %}#{% else %}{{ collection.url }}{% endif %}" class="collection-card">
            <div class="collection-card__image-wrapper">
              {%- if collection != empty and collection.image != blank -%}
                <img srcset="{{ collection.image | image_url: width: 600 }} 1x, {{ collection.image | image_url: width: 1200 }} 2x"
                  src="{{ collection.image | image_url: width: 600 }}"
                  loading="lazy"
                  width="{{ collection.image.width }}"
                  height="{{ collection.image.height }}"
                  alt="{{ collection.image.alt | default: collection.title | escape }}"
                  class="collection-card__image"
                >
              {%- elsif collection != empty and collection.products.first.featured_image != blank -%}
                <img srcset="{{ collection.products.first.featured_image | image_url: width: 600 }} 1x, {{ collection.products.first.featured_image | image_url: width: 1200 }} 2x"
                  src="{{ collection.products.first.featured_image | image_url: width: 600 }}"
                  loading="lazy"
                  width="{{ collection.products.first.featured_image.width }}"
                  height="{{ collection.products.first.featured_image.height }}"
                  alt="{{ collection.products.first.featured_image.alt | default: collection.title | escape }}"
                  class="collection-card__image"
                >
              {%- else -%}
                <div class="collection-card__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="collection-card__info">
              <h3 class="h4">
                {%- if collection == empty -%}
                  Your collection
                {%- else -%}
                  {{ collection.title }}
                {%- endif -%}
              </h3>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .collection-grid {
    padding: var(--section-spacing) 0;
  }
  .collection-grid__header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .collection-grid__items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .collection-grid__items {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  /* Asymmetric Layout */
  @media screen and (min-width: 750px) {
    .collection-grid__items--asymmetric .collection-grid__item:nth-child(odd) {
      transform: translateY(2rem);
    }
    .collection-grid__items--asymmetric .collection-grid__item:nth-child(even) {
      transform: translateY(-2rem);
    }
  }

  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    overflow: hidden;
  }
  .collection-card__image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 120%; /* 5:6 aspect ratio */
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.05);
    border-radius: 8px;
  }
  .collection-card__image,
  .collection-card__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .collection-card:hover .collection-card__image {
    transform: scale(1.05);
  }
  .collection-card__info {
    padding-top: 1rem;
    text-align: center;
  }
</style>

{% schema %}
{
  "name": "Collection grid",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shop by category",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "asymmetric",
          "label": "Asymmetric alternating"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
