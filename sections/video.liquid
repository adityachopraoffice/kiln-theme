<div class="video-section color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="video-section__header animate-on-scroll">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="h2" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- when 'subheading' -%}
              <p class="h5" {{ block.shopify_attributes }}>{{ block.settings.subheading | escape }}</p>
            {%- when 'text' -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="video-section__media animate-on-scroll">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1100x', loop: true, controls: true, muted: false, class: 'video-section__video' }}
      {%- elsif section.settings.external_video_url != blank -%}
        <div class="video-section__iframe-wrapper" style="padding-bottom: 56.25%;">
          {%- if section.settings.external_video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.external_video_url.id }}?enablejsapi=1" class="video-section__iframe" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.description | escape }}"></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.external_video_url.id }}" class="video-section__iframe" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.description | escape }}"></iframe>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- if section.settings.cover_image != blank -%}
          <img
            srcset="{{ section.settings.cover_image | image_url: width: 1100 }} 1x, {{ section.settings.cover_image | image_url: width: 2200 }} 2x"
            src="{{ section.settings.cover_image | image_url: width: 1100 }}"
            alt="{{ section.settings.cover_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.cover_image.width }}"
            height="{{ section.settings.cover_image.height }}"
            class="video-section__cover"
          >
        {%- else -%}
          <div class="video-section__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .video-section {
    padding: var(--section-spacing) 0;
  }
  .video-section__header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .video-section__media {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
  }
  .video-section__video,
  .video-section__cover,
  .video-section__placeholder svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .video-section__iframe-wrapper {
    position: relative;
    width: 100%;
    height: 0;
  }
  .video-section__iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "external_video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "label": "URL",
      "info": "Use a YouTube or Vimeo URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image",
      "info": "Used as a fallback if no video is provided."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Video alt text",
      "info": "Describe the video for screen readers."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Video",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Watch our latest video",
          "label": "Subheading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share information about your brand with your customers.</p>",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video",
      "blocks": [
        {
          "type": "heading"
        }
      ]
    }
  ]
}
{% endschema %}
