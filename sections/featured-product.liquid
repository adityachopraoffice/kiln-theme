{%- assign product = all_products[section.settings.product] -%}
<div class="featured-product color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="featured-product__inner">
      <div class="featured-product__media">
        {%- if product != empty and product.media.size > 0 -%}
          <div class="product__media-list" style="display:flex; flex-direction:column; gap:1rem;">
            {%- for media in product.media -%}
              <div class="product__media-item" data-media-id="{{ media.id }}" {% if media.preview_image %}data-image-id="{{ media.preview_image.id }}"{% endif %}>
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img srcset="{{ media | image_url: width: 800 }} 1x, {{ media | image_url: width: 1600 }} 2x"
                      src="{{ media | image_url: width: 800 }}"
                      loading="lazy"
                      width="{{ media.width }}"
                      height="{{ media.height }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      class="featured-product__image"
                    >
                  {%- when 'external_video' -%}
                    <div class="product__media-video" style="position: relative; padding-bottom: 56.25%; height: 0;">
                      <iframe src="{{ media | external_video_url }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; border-radius: 8px;" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                    </div>
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, style: 'width: 100%; height: auto; border-radius: 8px;' }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag: style: 'width: 100%; height: 400px; border-radius: 8px;' }}
                    <button class="button button--full-width product__xr-button" type="button" aria-label="View in your space" data-shopify-xr data-shopify-model3d-id="{{ media.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden style="margin-top:0.5rem;">
                      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-3d" viewBox="18.24 17.35 24.52 28.3" width="20" height="20" style="margin-right: 0.5rem;"><path fill="currentColor" d="M30.5 17.35l-12.26 7.07v14.16l12.26 7.07 12.26-7.08V24.42L30.5 17.35zM20.24 37.42V25.58l10.26-5.92v11.84l-10.26 5.92zm11.26-12.98l-10.26-5.92 10.26-5.92 10.26 5.92-10.26 5.92zm1.06 12.98l10.26-5.92V25.58l-10.26 5.92v11.84z"></path></svg>
                      View in your space
                    </button>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="featured-product__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="featured-product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'title' -%}
              <h2 class="featured-product__title h1" {{ block.shopify_attributes }}>
                {%- if product != empty -%}
                  {{ product.title }}
                {%- else -%}
                  Example Product
                {%- endif -%}
              </h2>
            {%- when 'price' -%}
              <div class="featured-product__price" {{ block.shopify_attributes }}>
                {%- if product != empty -%}
                  {%- render 'price', product: product, use_variant: true -%}
                  {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
                    <div class="product__unit-price caption" style="margin-top: 0.5rem; color: rgba(var(--color-foreground), 0.7);">
                      <span class="visually-hidden">Unit price</span>
                      <span>
                        {{- product.selected_or_first_available_variant.unit_price | money -}}
                        <span aria-hidden="true">/</span>
                        <span class="visually-hidden">&nbsp;per&nbsp;</span>
                        {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
                          {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
                      </span>
                    </div>
                  {%- endif -%}
                  {%- if cart.taxes_included -%}
                    <div class="product__tax caption">Tax included.</div>
                  {%- endif -%}
                {%- else -%}
                  <span class="price-item">$19.99</span>
                {%- endif -%}
              </div>
            {%- when 'vendor' -%}
              <div class="featured-product__vendor" {{ block.shopify_attributes }}>
                {{ product.vendor | default: shop.name }}
              </div>
            {%- when 'description' -%}
              <div class="featured-product__description rte" {{ block.shopify_attributes }}>
                {%- if product != empty -%}
                  {{ product.description }}
                {%- else -%}
                  <p>This is a demonstration of how a product description might look.</p>
                {%- endif -%}
              </div>
            {%- when 'buy_buttons' -%}
              <div class="featured-product__buy-buttons" {{ block.shopify_attributes }}>
                {%- if product != empty -%}
                  {%- form 'product', product -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    
                    {%- if product.selling_plan_groups.size > 0 -%}
                      <div class="product-form__selling-plans" style="margin-bottom: 1rem;">
                        <label class="form__label" for="SellingPlan-{{ section.id }}">Purchase options</label>
                        <select name="selling_plan" id="SellingPlan-{{ section.id }}" class="field__input" style="width: 100%; padding:0.5rem; border:1px solid rgba(var(--color-foreground),0.2);">
                          <option value="">One-time purchase</option>
                          {%- for group in product.selling_plan_groups -%}
                            <optgroup label="{{ group.name }}">
                              {%- for plan in group.selling_plans -%}
                                <option value="{{ plan.id }}">{{ plan.name }}</option>
                              {%- endfor -%}
                            </optgroup>
                          {%- endfor -%}
                        </select>
                      </div>
                    {%- endif -%}

                    <button type="submit" name="add" class="button button--full-width" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      <div style="margin-top:1rem;">{{ form | payment_button }}</div>
                    {%- endif -%}
                    <div class="product-form__payment-terms" style="margin-top: 1rem;">
                      {{ form | payment_terms }}
                    </div>
                  {%- endform -%}
                {%- else -%}
                  <button type="button" class="button button--full-width">Add to cart</button>
                {%- endif -%}
              </div>
            {%- when 'makers_note' -%}
              <div class="featured-product__makers-note" {{ block.shopify_attributes }}>
                <h3 class="h6">{{ 'products.product.makers_note' | t }}</h3>
                <div class="rte">{{ block.settings.note }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  .featured-product {
    padding: var(--section-spacing) 0;
  }
  .featured-product__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media screen and (min-width: 750px) {
    .featured-product__inner {
      flex-direction: row;
      align-items: center;
    }
    .featured-product__media,
    .featured-product__info {
      width: 50%;
    }
  }
  .featured-product__image {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .featured-product__title {
    margin-bottom: 0.5rem;
  }
  .featured-product__price {
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
  }
  .featured-product__buy-buttons {
    margin-top: 2rem;
  }
  .button--full-width {
    width: 100%;
  }
</style>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout buttons"
        }
      ]
    },
    {
      "type": "makers_note",
      "name": "Maker's note",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "note",
          "label": "Note content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "description"
        },
        {
          "type": "buy_buttons"
        }
      ]
    }
  ]
}
{% endschema %}
