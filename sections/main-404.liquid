<div class="main-404 color-scheme-linen">
  <div class="page-width">
    <div class="main-404__content text-center">
      <h1 class="main-404__title">{{ 'templates.404.title' | t }}</h1>
      <p class="main-404__subtext">{{ 'templates.404.subtext' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  </div>
</div>

<style>
  .main-404 {
    padding: calc(var(--section-spacing) * 2) 0;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .main-404__content {
    max-width: 600px;
    margin: 0 auto;
  }
  .main-404__title {
    font-size: 8rem;
    margin: 0 0 1rem 0;
    line-height: 1;
  }
  .main-404__subtext {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }
</style>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
