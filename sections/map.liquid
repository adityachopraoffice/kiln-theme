<div class="map color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="map__inner">
      <div class="map__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 map__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <div class="map__block" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'address' -%}
                <div class="map__address rte">
                  {{ block.settings.address }}
                </div>
              {%- when 'hours' -%}
                <div class="map__hours rte">
                  {{ block.settings.hours }}
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="map__media">
        {%- if section.settings.map_url != blank -%}
          <iframe 
            src="{{ section.settings.map_url }}" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="map__iframe"
            title="Map location"
          ></iframe>
        {%- else -%}
          <div class="map__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .map {
    padding: var(--section-spacing) 0;
  }
  .map__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media screen and (min-width: 750px) {
    .map__inner {
      flex-direction: row;
    }
    .map__content {
      width: 40%;
      padding-right: 4rem;
    }
    .map__media {
      width: 60%;
    }
  }
  .map__heading {
    margin-bottom: 2rem;
  }
  .map__block {
    margin-bottom: 1.5rem;
  }
  .map__media {
    position: relative;
    padding-bottom: 75%; /* 4:3 aspect ratio */
    min-height: 400px;
    background-color: rgba(var(--color-foreground), 0.05);
    border-radius: 8px;
    overflow: hidden;
  }
  .map__iframe,
  .map__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .map__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

{% schema %}
{
  "name": "Map",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Visit our studio",
      "label": "Heading"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Google Maps embed URL",
      "info": "Find location on Google Maps -> Share -> Embed a map -> Copy src URL"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "address",
      "name": "Address",
      "settings": [
        {
          "type": "richtext",
          "id": "address",
          "default": "<p>123 Maker Street<br>Portland, OR 97204</p>",
          "label": "Address"
        }
      ]
    },
    {
      "type": "hours",
      "name": "Hours",
      "settings": [
        {
          "type": "richtext",
          "id": "hours",
          "default": "<p>Mon - Fri: 10am - 6pm<br>Sat - Sun: 11am - 4pm</p>",
          "label": "Hours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Map",
      "blocks": [
        {
          "type": "address"
        },
        {
          "type": "hours"
        }
      ]
    }
  ]
}
{% endschema %}
