<div class="customer register page-width" style="padding: 4rem 0; max-width: 500px; margin: 0 auto; text-align: center;">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <div class="form__message" style="color: red; margin-bottom: 1rem;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="field" style="margin-bottom: 1rem;">
      <input type="text" name="customer[first_name]" id="RegisterForm-FirstName" autocomplete="given-name" placeholder="First Name" style="width:100%; padding: 0.5rem;">
    </div>

    <div class="field" style="margin-bottom: 1rem;">
      <input type="text" name="customer[last_name]" id="RegisterForm-LastName" autocomplete="family-name" placeholder="Last Name" style="width:100%; padding: 0.5rem;">
    </div>

    <div class="field" style="margin-bottom: 1rem;">
      <input type="email" name="customer[email]" id="RegisterForm-email" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="Email" style="width:100%; padding: 0.5rem;" required>
    </div>

    <div class="field" style="margin-bottom: 1rem;">
      <input type="password" name="customer[password]" id="RegisterForm-password" placeholder="Password" style="width:100%; padding: 0.5rem;" required>
    </div>

    <button type="submit" class="button" style="width:100%; padding: 0.5rem;">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}
