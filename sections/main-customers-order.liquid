<div class="customer order page-width" style="padding: 4rem 0;">
  <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p>{{ 'customer.order.date' | t: date: order.created_at | time_tag: format: 'date_at_time' }}</p>
  {%- if order.cancelled -%}
    <p>{{ 'customer.order.cancelled' | t: date: order.cancelled_at | time_tag: format: 'date_at_time' }}<br>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
  {%- endif -%}

  <div style="margin-top: 2rem;">
    <table style="width:100%; text-align:left; border-collapse: collapse;">
      <thead>
        <tr>
          <th style="padding-bottom: 1rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">{{ 'customer.order.product' | t }}</th>
          <th style="padding-bottom: 1rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">{{ 'customer.order.price' | t }}</th>
          <th style="padding-bottom: 1rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">{{ 'customer.order.quantity' | t }}</th>
          <th style="padding-bottom: 1rem; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td style="padding: 1rem 0; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">
              {%- if line_item.url != blank -%}
                <a href="{{ line_item.url }}">{{ line_item.title }}</a>
              {%- else -%}
                {{ line_item.title }}
              {%- endif -%}
              
              {%- if line_item.selling_plan_allocation -%}
                <p style="margin: 0.5rem 0; font-size: 0.9em; color: rgba(var(--color-foreground), 0.7);">
                  {{ line_item.selling_plan_allocation.selling_plan.name }}
                </p>
              {%- endif -%}
            </td>
            <td style="padding: 1rem 0; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">
              {%- if line_item.original_price != line_item.final_price -%}
                <dl style="margin:0;">
                  <dt class="visually-hidden">{{ 'cart.label.regular_price' | t }}</dt>
                  <dd style="margin:0;"><s>{{ line_item.original_price | money }}</s></dd>
                  <dt class="visually-hidden">{{ 'cart.label.sale_price' | t }}</dt>
                  <dd style="margin:0;">{{ line_item.final_price | money }}</dd>
                </dl>
              {%- else -%}
                {{ line_item.original_price | money }}
              {%- endif -%}
              
              {%- if line_item.unit_price_measurement -%}
                <div class="unit-price" style="margin-top:0.25rem; font-size: 0.85em; color: rgba(var(--color-foreground), 0.7);">
                  {{ line_item.unit_price | money }} / 
                  {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                    {{- line_item.unit_price_measurement.reference_value -}}
                  {%- endif -%}
                  {{ line_item.unit_price_measurement.reference_unit }}
                </div>
              {%- endif -%}
              
              {%- if line_item.line_level_discount_allocations != blank -%}
                <ul role="list" aria-label="Discount" style="list-style:none; padding:0; margin:0.5rem 0 0;">
                  {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                    <li style="font-size: 0.85em; color: rgba(var(--color-foreground), 0.7);">
                      {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </td>
            <td style="padding: 1rem 0; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">
              {{ line_item.quantity }}
            </td>
            <td style="padding: 1rem 0; border-bottom: 1px solid rgba(var(--color-foreground), 0.1);">
              {{ line_item.final_line_price | money }}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot style="font-weight: bold;">
        <tr>
          <td colspan="3" style="padding-top: 1.5rem;">{{ 'customer.order.subtotal' | t }}</td>
          <td style="padding-top: 1.5rem;">{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- if order.cart_level_discount_applications != blank -%}
          <tr>
            <td colspan="3" style="padding-top: 0.5rem; font-weight: normal;">{{ 'customer.order.discount' | t }}</td>
            <td style="padding-top: 0.5rem; font-weight: normal;">
              <ul role="list" aria-label="Discount" style="list-style:none; padding:0; margin:0;">
                {%- for discount_application in order.cart_level_discount_applications -%}
                  <li>
                    {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            </td>
          </tr>
        {%- endif -%}
        <tr>
          <td colspan="3" style="padding-top: 0.5rem;">{{ 'customer.order.total' | t }}</td>
          <td style="padding-top: 0.5rem; font-size:1.2em;">{{ order.total_price | money_with_currency }}</td>
        </tr>
      </tfoot>
    </table>
  </div>
  
  <div style="margin-top: 3rem; display: flex; gap: 4rem; flex-wrap: wrap;">
    <div>
      <h2>{{ 'customer.order.billing_address' | t }}</h2>
      <p><strong>{{ 'customer.order.payment_status' | t }}</strong> {{ order.financial_status_label }}</p>
      {{ order.billing_address | format_address }}
    </div>

    <div>
      <h2>{{ 'customer.order.shipping_address' | t }}</h2>
      <p><strong>{{ 'customer.order.fulfillment_status' | t }}</strong> {{ order.fulfillment_status_label }}</p>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
