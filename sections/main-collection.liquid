<div class="main-collection color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="collection-header animate-on-scroll">
      <h1 class="collection-header__title h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-header__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    <form id="CollectionFiltersForm" class="collection-toolbar animate-on-scroll delay-1">
      <div class="collection-toolbar__filters">
        <!-- Faceted Search Placeholder (Typically requires JS to handle Shopify's filter API properly) -->
        <details class="facets__disclosure">
          <summary class="facets__summary caption-large focus-offset">
            <span>Filter</span>
          </summary>
          <div class="active-filters" style="margin-top: 1rem;">
            <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="button button--secondary" style="font-size: 0.8rem; padding: 0.3rem 0.6rem;">Clear all filters</a>
          </div>
          <div class="facets__display">
            {%- for filter in collection.filters -%}
              <details class="facets__disclosure-inner">
                <summary class="facets__summary-inner">
                  <span>{{ filter.label }}</span>
                </summary>
                <div class="facets__display-inner">
                  {%- case filter.type -%}
                    {%- when 'boolean', 'list' -%}
                      <ul class="facets__list list-unstyled" role="list">
                        {%- for value in filter.values -%}
                          <li class="list-menu__item facets__item">
                            <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}">
                              <input type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              {{ value.label | escape }} ({{ value.count }})
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'price_range' -%}
                      <div class="facets__price" style="display: flex; gap: 1rem; align-items: flex-end; padding-top: 0.5rem;">
                        <span class="field-currency" style="padding-bottom: 0.5rem;">{{ cart.currency.symbol }}</span>
                        <div class="field" style="display: flex; flex-direction: column; gap: 0.3rem;">
                          <label for="Filter-{{ filter.label | escape }}-GTE" style="font-size: 0.8rem;">From</label>
                          <input type="number"
                            name="{{ filter.min_value.param_name }}"
                            id="Filter-{{ filter.label | escape }}-GTE"
                            {% if filter.min_value.value %}
                              value="{{ filter.min_value.value | divided_by: 100 }}"
                            {% endif %}
                            placeholder="0"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 | ceil }}"
                            style="width: 80px; padding: 0.5rem; border: 1px solid rgba(var(--color-foreground), 0.2); background: transparent; color: inherit;"
                          >
                        </div>
                        <div class="field" style="display: flex; flex-direction: column; gap: 0.3rem;">
                          <label for="Filter-{{ filter.label | escape }}-LTE" style="font-size: 0.8rem;">To</label>
                          <input type="number"
                            name="{{ filter.max_value.param_name }}"
                            id="Filter-{{ filter.label | escape }}-LTE"
                            {% if filter.max_value.value %}
                              value="{{ filter.max_value.value | divided_by: 100 }}"
                            {% endif %}
                            placeholder="{{ filter.range_max | divided_by: 100 | ceil }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 | ceil }}"
                            style="width: 80px; padding: 0.5rem; border: 1px solid rgba(var(--color-foreground), 0.2); background: transparent; color: inherit;"
                          >
                        </div>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
            <div style="padding-top: 1rem; border-top: 1px solid rgba(var(--color-foreground), 0.1); margin-top: 1rem;">
              <button type="submit" class="quick-add-button" style="width: 100%;">Apply Filters</button>
            </div>
          </div>
        </details>
      </div>

      <div class="collection-toolbar__sort">
        <label for="SortBy">Sort by</label>
        <select name="sort_by" class="facet-filters__sort select__select caption-large" id="SortBy" aria-describedby="a11y-refresh-page-message">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == collection.sort_by %} selected="selected"{% endif %}>
              {{ option.name | escape }}
            </option>
          {%- endfor -%}
        </select>
      </div>
      
      <div class="collection-toolbar__view">
        <button type="button" class="view-toggle is-active" data-view="grid" aria-label="Grid view" title="Grid view">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-grid" viewBox="0 0 24 24" width="24" height="24">
            <path fill="currentColor" d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z"/>
          </svg>
        </button>
        <button type="button" class="view-toggle" data-view="list" aria-label="List view" title="List view">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-list" viewBox="0 0 24 24" width="24" height="24">
            <path fill="currentColor" d="M3 4h4v4H3zm6 1h12v2H9zm-6 5h4v4H3zm6 1h12v2H9zm-6 5h4v4H3zm6 1h12v2H9z"/>
          </svg>
        </button>
      </div>
    </form>

    {%- if collection.products.size == 0 -%}
      <div class="collection-empty">
        <h2 class="h4">{{ 'collections.general.no_matches' | t }}</h2>
      </div>
    {%- else -%}
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection-grid {% if section.settings.asymmetric_grid %}collection-grid--asymmetric{% endif %}" id="ProductGridContainer">
          {%- for product in collection.products -%}
            <div class="collection-grid__item animate-on-scroll">
              <div class="product-card">
                <a href="{{ product.url }}" style="display:block;">
                  <div class="product-card__image-wrapper">
                  {%- if product.featured_media -%}
                    <img srcset="{{ product.featured_media | image_url: width: 600 }} 1x, {{ product.featured_media | image_url: width: 1200 }} 2x"
                      src="{{ product.featured_media | image_url: width: 600 }}"
                      loading="lazy"
                      width="{{ product.featured_media.width }}"
                      height="{{ product.featured_media.height }}"
                      alt="{{ product.featured_media.alt | default: product.title | escape }}"
                      class="product-card__image"
                    >
                  {%- else -%}
                    <div class="product-card__placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                  
                  {%- if product.compare_at_price > product.price -%}
                    <span class="badge badge--sale">Sale</span>
                  {%- endif -%}
                </div>
                </a>
                
                <div class="product-card__info">
                  <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
                    <h3 class="h5 product-card__title">{{ product.title }}</h3>
                  </a>
                  <div class="product-card__price">
                    {%- if product.price_varies -%}
                      {%- assign price_min_money = product.price_min | money -%}
                      <span class="price-item">{{ 'products.product.price.from_price_html' | t: price: price_min_money }}</span>
                    {%- else -%}
                      <span class="price-item">{{ product.price | money }}</span>
                    {%- endif -%}
                    
                    {%- if product.compare_at_price > product.price -%}
                      <s class="price-item--sale">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                    
                    {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
                      <div class="unit-price caption">
                        <span>{{ product.selected_or_first_available_variant.unit_price | money }}</span>
                        <span aria-hidden="true">/</span>
                        <span>
                          {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
                            {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
                          {%- endif -%}
                          {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                  
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'small_batch_label' -%}
                        {%- if product.tags contains 'small batch' or product.tags contains 'Small Batch' -%}
                          <span class="product-tag product-tag--small-batch">{{ 'products.product.small_batch' | t }}</span>
                        {%- endif -%}
                      {%- when 'made_to_order_label' -%}
                        {%- if product.tags contains 'made to order' or product.tags contains 'Made to Order' -%}
                          <span class="product-tag product-tag--made-to-order">{{ 'products.product.made_to_order' | t }}</span>
                        {%- endif -%}
                    {%- endcase -%}
                  {%- endfor -%}
                  
                  <div class="product-card__quick-add">
                    {%- assign product_form_id = 'quick-add-' | append: section.id | append: product.id -%}
                    {%- form 'product', product, id: product_form_id, class: 'form' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" name="add" class="button quick-add-button" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                        <span>
                          {%- if product.selected_or_first_available_variant.available -%}
                            {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                          {%- else -%}
                            {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                          {%- endif -%}
                        </span>
                      </button>
                    {%- endform -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
            <ul class="pagination__list list-unstyled" role="list">
              {%- if paginate.previous -%}
                <li>
                  <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev" aria-label="{{ 'general.pagination.previous' | t }}">
                    &larr; Prev
                  </a>
                </li>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                <li>
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <span class="pagination__item pagination__item--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
                    {%- else -%}
                      <span class="pagination__item">{{ part.title }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}

              {%- if paginate.next -%}
                <li>
                  <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next" aria-label="{{ 'general.pagination.next' | t }}">
                    Next &rarr;
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

<style>
  .main-collection {
    padding: var(--section-spacing) 0;
  }
  .collection-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .collection-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .collection-toolbar__sort select {
    padding: 0.5rem;
    border: 1px solid var(--color-foreground);
    background: transparent;
    color: inherit;
  }
  .collection-toolbar__view button {
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    margin-left: 0.5rem;
    padding: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }
  .collection-toolbar__view button:hover,
  .collection-toolbar__view button.is-active {
    opacity: 1;
  }
  
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .collection-grid--asymmetric .collection-grid__item:nth-child(even) {
      transform: translateY(2rem);
    }
  }

  .collection-list-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .collection-list-view .product-card {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .collection-list-view .product-card__image-wrapper {
    width: 250px;
    flex-shrink: 0;
    margin-bottom: 0;
    padding-bottom: 300px;
  }
  @media screen and (max-width: 749px) {
    .collection-list-view .product-card {
      flex-direction: column;
      align-items: stretch;
    }
    .collection-list-view .product-card > a {
      width: 100%;
    }
    .collection-list-view .product-card__image-wrapper {
      width: 100%;
      padding-bottom: 125%;
    }
  }

  .product-card {
    display: block;
    color: inherit;
  }
  .product-card__image-wrapper {
    position: relative;
    padding-bottom: 125%; /* 4:5 aspect ratio */
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.05);
    border-radius: 4px;
    margin-bottom: 1rem;
  }
  .product-card__image,
  .product-card__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .product-card:hover .product-card__image,
  .product-card:hover .product-card__placeholder {
    transform: scale(1.05);
  }
  .badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .product-card__title {
    margin: 0 0 0.5rem 0;
    transition: opacity 0.3s ease;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-card:hover .product-card__title {
    opacity: 0.7;
  }
  .product-tag {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: rgba(var(--color-foreground), 0.1);
    border-radius: 2px;
    margin-top: 0.5rem;
    margin-right: 0.5rem;
  }
  .product-card__quick-add {
    margin-top: 1rem;
  }
  .quick-add-button {
    width: 100%;
    padding: 0.8rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    transition: opacity 0.3s ease;
  }
  .quick-add-button:hover {
    opacity: 0.8;
  }
  .quick-add-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  
  .pagination__list {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 4rem;
    list-style: none;
    padding: 0;
  }
  .pagination__item {
    text-decoration: none;
    color: inherit;
  }
  .pagination__item--current {
    font-weight: bold;
    text-decoration: underline;
  }
</style>

<script>
  document.getElementById('CollectionFiltersForm')?.addEventListener('change', function(event) {
    if (event.target.tagName === 'SELECT') {
      const formData = new FormData(this);
      const searchParams = new URLSearchParams(formData);
      window.location.search = searchParams.toString();
    }
  });
  
  document.getElementById('CollectionFiltersForm')?.addEventListener('submit', function(event) {
    event.preventDefault();
    const formData = new FormData(this);
    const searchParams = new URLSearchParams(formData);
    window.location.search = searchParams.toString();
  });

  document.querySelectorAll('.view-toggle').forEach(button => {
    button.addEventListener('click', function() {
      const view = this.dataset.view;
      const grid = document.getElementById('ProductGridContainer');
      
      document.querySelectorAll('.view-toggle').forEach(b => b.classList.remove('is-active'));
      this.classList.add('is-active');

      if (view === 'list') {
        grid.classList.add('collection-list-view');
        grid.classList.remove('collection-grid');
      } else {
        grid.classList.add('collection-grid');
        grid.classList.remove('collection-list-view');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Collection pages",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "asymmetric_grid",
      "default": false,
      "label": "Use asymmetric grid"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "small_batch_label",
      "name": "Small Batch label",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows 'Small Batch' label if product has the 'small batch' tag."
        }
      ]
    },
    {
      "type": "made_to_order_label",
      "name": "Made to Order label",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows 'Made to Order' label if product has the 'made to order' tag."
        }
      ]
    }
  ]
}
{% endschema %}
