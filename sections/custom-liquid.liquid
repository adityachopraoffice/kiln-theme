<div class="custom-liquid">
  <div class="page-width">
    {{ section.settings.custom_liquid }}
  </div>
</div>

<style>
  .custom-liquid {
    padding: var(--section-spacing) 0;
  }
</style>

{% schema %}
{
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Add custom Liquid code or app embed code"
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
