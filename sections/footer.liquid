<footer class="footer color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="footer__content">
      
      <div class="footer__blocks-wrapper">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
              <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__block-heading h4">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__menu list-unstyled">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>
                        <a href="{{ link.url }}" class="footer__menu-item"{% if link.current %} aria-current="page"{% endif %}>
                          {{ link.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- when 'text' -%}
              <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__block-heading h4">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <div class="rte" style="line-height: 1.6; opacity: 0.8; font-size: 0.95rem;">{{ block.settings.subtext }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="footer__block footer__block--newsletter">
        <h2 class="footer__block-heading h4">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer__newsletter-wrapper">
            <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
            <input
              id="FooterNewsletterEmail"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Email address"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="FooterNewsletter-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="FooterNewsletter-success"
              {% endif %}
            >
            <button type="submit" class="button" name="commit" id="Subscribe" aria-label="Subscribe">
              Subscribe
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="FooterNewsletter-error">
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="FooterNewsletter-success" tabindex="-1" autofocus>
              Thanks for subscribing!
            </h3>
          {%- endif -%}
        {%- endform -%}
      </div>
      
    </div>

    <div class="footer__content-bottom">
      <div class="footer__social">
        <ul class="footer__list-social list-unstyled" role="list">
          {%- if settings.social_instagram_link != blank -%}
            <li class="list-social__item">
              <a href="{{ settings.social_instagram_link }}" class="link list-social__link" >
                <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li class="list-social__item">
              <a href="{{ settings.social_facebook_link }}" class="link list-social__link" >
                <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <li class="list-social__item">
              <a href="{{ settings.social_pinterest_link }}" class="link list-social__link" >
                <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.25 2.65 7.89 6.44 9.25-.09-.79-.17-2 .04-2.86.2-.84 1.3-5.5 1.3-5.5s-.33-.66-.33-1.63c0-1.53.89-2.67 2-2.67.94 0 1.39.7 1.39 1.54 0 .94-.6 2.36-.92 3.67-.26 1.1.55 2 1.63 2 1.96 0 3.47-2.07 3.47-5.06 0-2.66-1.91-4.52-4.65-4.52-3.15 0-5 2.36-5 4.79 0 .94.36 1.95.81 2.5.09.11.1.2.07.31-.08.34-.27 1.1-.3 1.25-.05.19-.15.23-.35.14-1.3-.6-2.12-2.49-2.12-4.01 0-3.26 2.37-6.26 6.84-6.26 3.59 0 6.38 2.56 6.38 5.98 0 3.57-2.25 6.44-5.38 6.44-1.05 0-2.04-.55-2.38-1.2l-.65 2.48c-.24.91-.88 2.05-1.32 2.74A9.97 9.97 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"></path></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <li class="list-social__item">
              <a href="{{ settings.social_tiktok_link }}" class="link list-social__link" >
                <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <li class="list-social__item">
              <a href="{{ settings.social_youtube_link }}" class="link list-social__link" >
                <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="footer__follow-on-shop">
        {%- if section.settings.enable_follow_on_shop and shop.features.follow_on_shop? -%}
          {{ shop | login_button: action: 'follow' }}
        {%- endif -%}
      </div>

      <div class="footer__localization">
        {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
          {%- form 'localization', id: 'FooterLocalizationForm', class: 'localization-form' -%}
            {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
              <div class="localization-form__select">
                <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t | default: 'Country/region' }}</h2>
                <select name="country_code" aria-labelledby="FooterCountryLabel" class="localization-selector link">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
            {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
              <div class="localization-form__select">
                <h2 class="visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t | default: 'Language' }}</h2>
                <select name="locale_code" aria-labelledby="FooterLanguageLabel" class="localization-selector link">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}" {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          {%- endform -%}
          <script>
            document.querySelectorAll('#FooterLocalizationForm .localization-selector').forEach(selector => {
              selector.addEventListener('change', (e) => {
                e.target.closest('form').submit();
              });
            });
          </script>
        {%- endif -%}
      </div>

      <div class="footer__payment">
        <span class="visually-hidden">Payment methods</span>
        <ul class="list list-payment list-unstyled" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-payment__item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer__copyright">
        {%- if shop.policies != empty -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><small class="copyright__content"><a href="{{ policy.url }}" class="link">{{ policy.title }}</a></small></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <ul class="policies list-unstyled">
            <li><small class="copyright__content"><a href="/policies/privacy-policy" class="link">Privacy policy</a></small></li>
            <li><small class="copyright__content"><a href="/policies/terms-of-service" class="link">Terms of service</a></small></li>
            <li><small class="copyright__content"><a href="/policies/contact-information" class="link">Contact information</a></small></li>
          </ul>
        {%- endif -%}
        <small class="copyright__content">&copy; {{ 'now' | date: "%Y" }}, {{ shop.name | link_to: routes.root_url }}</small>
        <small class="copyright__content">{{ powered_by_link }}</small>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--section-spacing) 0;
    margin-top: var(--section-spacing);
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .footer__content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: var(--section-spacing);
  }
  @media screen and (min-width: 750px) {
    .footer__content {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .footer__blocks-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    flex: 2;
  }
  @media screen and (min-width: 750px) {
    .footer__blocks-wrapper {
      gap: 3rem;
    }
  }
  .footer__block--menu,
  .footer__block--text {
    flex: 1;
    min-width: 150px;
  }
  .footer__block--newsletter {
    flex: 1;
    width: 100%;
    max-width: 350px;
  }
  .list-unstyled {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer__menu-item {
    display: inline-block;
    padding: 0.5rem 0;
    text-decoration: none;
    color: inherit;
    word-break: break-word; /* Handle long navigation links */
  }
  .footer__menu-item:hover, .footer__menu-item:focus-visible {
    text-decoration: underline;
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
  .footer__block-heading {
    word-break: break-word;
  }
  .link:focus-visible, .button:focus-visible, input:focus-visible, select:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
  .footer__newsletter-wrapper {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .field__input {
    flex-grow: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-foreground);
    background: transparent;
    color: inherit;
  }
  .footer__content-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    padding-top: var(--section-spacing);
    text-align: center;
  }
  .footer__list-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .list-payment {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer__copyright {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .policies {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .policies li {
    position: relative;
  }
  .policies li:not(:last-child)::after {
    content: "•";
    position: absolute;
    right: -1rem;
    color: rgba(var(--color-foreground), 0.5);
  }
  .footer__follow-on-shop {
    margin-bottom: 1rem;
  }
  .footer__localization {
    margin-bottom: 1rem;
  }
  .localization-form {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .localization-form__select {
    position: relative;
  }
  .localization-selector {
    padding: 0.5rem 2rem 0.5rem 1rem;
    background-color: transparent;
    border: 1px solid var(--color-foreground);
    border-radius: 4px;
    color: var(--color-foreground);
    cursor: pointer;
    font-size: 0.9rem;
  }
  .localization-selector option {
    color: #000;
    background-color: #fff;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Subscribe to our emails",
      "label": "Newsletter heading"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "Enable Follow on Shop"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "Enable country/region selector"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "Enable language selector"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "About the shop",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "Subtext"
        }
      ]
    }
  ]
}
{% endschema %}
