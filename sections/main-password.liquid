<div class="password-header animate-on-scroll">
  <div class="page-width text-center">
    <h1 class="password-header__title h2">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="password-header__message rte">
        {{ shop.password_message }}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="password-content animate-on-scroll delay-1">
  <div class="page-width text-center">
    <h2 class="password-content__title h4" id="DialogHeading">
      {{ 'general.password_page.login_form_heading' | t }}
    </h2>
    <div class="password-form">
      {%- form 'storefront_password', class: 'password-form' -%}
        <div class="password-form__field">
          <label class="visually-hidden" for="Password">
            {{ 'general.password_page.login_form_password_label' | t }}
          </label>
          <input
            type="password"
            name="password"
            id="Password"
            class="field__input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordLoginForm-password-error"
            {%- endif -%}
          >
          <button name="commit" class="button">
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        </div>
        {%- if form.errors -%}
          <div id="PasswordLoginForm-password-error" role="status" class="form__message form__message--error">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            <span class="form-message">{{ form.errors.messages['form'] }}</span>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
    <p class="password-content__admin-link caption">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</div>

<style>
  .password-header {
    margin-bottom: 3rem;
  }
  .password-header__title {
    margin-bottom: 1rem;
    word-break: break-word;
  }
  .password-header__message {
    word-break: break-word;
  }
  .password-content {
    max-width: 500px;
    margin: 0 auto;
  }
  .password-form__field {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    margin-top: 2rem;
  }
  .password-content__admin-link {
    margin-top: 2rem;
    opacity: 0.7;
  }
  .form__message--error {
    color: red;
  }
</style>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
