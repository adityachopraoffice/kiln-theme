<div class="main-gift-card color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="gift-card__container">
      <header class="gift-card__header text-center">
        <h1 class="gift-card__title h2">{{ shop.name }}</h1>
        <h2 class="gift-card__heading h3">{{ 'gift_cards.issued.subtext' | t }}</h2>
        <div class="gift-card__price">
          <p>
            {% if gift_card.initial_value != gift_card.balance %}
              {{ 'gift_cards.issued.remaining_html' | t: balance: gift_card.balance | money }}
            {% else %}
              {{ gift_card.initial_value | money }}
            {% endif %}
          </p>
        </div>
      </header>

      <main class="gift-card__content text-center">
        <div class="gift-card__image-wrapper">
          <img src="{{ 'gift-card/card.svg' | shopify_asset_url }}" alt="Gift card illustration" class="gift-card__image" height="300" width="450" loading="lazy">
        </div>

        <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>

        <div class="gift-card__information">
          <input
            type="text"
            class="gift-card__number field__input text-center"
            value="{{ gift_card.code | format_code }}"
            aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}"
            readonly
          >
          <div class="gift-card__copy-success form__message form__message--success visually-hidden" role="status"></div>
          <button class="button gift-card__copy-button" style="margin-bottom: 1.5rem;">{{ 'gift_cards.issued.copy_code' | t }}</button>
          
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="gift_card__apple-wallet">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t | default: 'Add To Apple Wallet' }}" loading="lazy" style="display:block; margin: 0 auto;">
            </a>
          {%- endif -%}
        </div>

        <div class="gift-card__buttons">
          <a href="{{ shop.url }}" class="button button--secondary" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
          <button class="button button--secondary gift-card__print-button" onclick="window.print();">
            {{ 'gift_cards.issued.print_gift_card' | t }}
          </button>
        </div>
      </main>
    </div>
  </div>
</div>

<style>
  .main-gift-card {
    padding: calc(var(--section-spacing) * 1.5) 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gift-card__container {
    max-width: 600px;
    margin: 0 auto;
    background: rgba(var(--color-background), 1);
    padding: 3rem;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(var(--color-foreground), 0.1);
  }
  .text-center {
    text-align: center;
  }
  .gift-card__title {
    margin-bottom: 0.5rem;
  }
  .gift-card__price {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }
  .gift-card__image-wrapper {
    margin-bottom: 2rem;
  }
  .gift-card__image {
    max-width: 100%;
    height: auto;
  }
  .gift-card__qr-code {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }
  .gift-card__number {
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    cursor: default;
  }
  .gift-card__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 3rem;
  }
  @media screen and (min-width: 750px) {
    .gift-card__buttons {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new QRCode(document.querySelector('.gift-card__qr-code'), {
      text: document.querySelector('.gift-card__qr-code').dataset.identifier,
      width: 120,
      height: 120
    });

    const copyButton = document.querySelector('.gift-card__copy-button');
    const input = document.querySelector('.gift-card__number');
    const successMessage = document.querySelector('.gift-card__copy-success');

    if (copyButton && input) {
      copyButton.addEventListener('click', () => {
        navigator.clipboard.writeText(input.value).then(() => {
          successMessage.textContent = 'Code copied to clipboard';
          successMessage.classList.remove('visually-hidden');
          setTimeout(() => {
            successMessage.classList.add('visually-hidden');
          }, 3000);
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Gift card",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ]
}
{% endschema %}
