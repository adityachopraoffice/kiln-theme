<div class="logo-list color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="logo-list__header">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="logo-list__items {% if section.settings.greyscale %}logo-list__items--greyscale{% endif %}">
      {%- for block in section.blocks -%}
        <div class="logo-list__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="logo-list__link">
          {%- endif -%}
          
          {%- if block.settings.image != blank -%}
            <img srcset="{{ block.settings.image | image_url: width: 300 }} 1x, {{ block.settings.image | image_url: width: 600 }} 2x"
              src="{{ block.settings.image | image_url: width: 300 }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.image.alt | escape }}"
              class="logo-list__image"
            >
          {%- else -%}
            <div class="logo-list__placeholder">
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .logo-list {
    padding: var(--section-spacing) 0;
  }
  .logo-list__header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .logo-list__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 3rem;
  }
  .logo-list__item {
    flex: 0 0 150px;
  }
  @media screen and (min-width: 750px) {
    .logo-list__item {
      flex: 0 0 200px;
    }
  }
  .logo-list__link {
    display: block;
    transition: opacity 0.3s;
  }
  .logo-list__link:hover {
    opacity: 0.7;
  }
  .logo-list__image,
  .logo-list__placeholder {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .logo-list__items--greyscale .logo-list__image {
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter 0.3s, opacity 0.3s;
  }
  .logo-list__items--greyscale .logo-list__item:hover .logo-list__image {
    filter: grayscale(0%);
    opacity: 1;
  }
</style>

{% schema %}
{
  "name": "Logo list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Our partners",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "greyscale",
      "default": true,
      "label": "Greyscale images"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
