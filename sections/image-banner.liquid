<div class="image-banner color-scheme-{{ section.settings.color_scheme }}">
  <div class="image-banner__media" style="--focal-point: {{ section.settings.image.presentation.focal_point }};">
    {%- if section.settings.image != blank -%}
      <img srcset="{{ section.settings.image | image_url: width: 750 }} 1x, {{ section.settings.image | image_url: width: 1500 }} 2x, {{ section.settings.image | image_url: width: 3000 }} 3x"
        src="{{ section.settings.image | image_url: width: 1500 }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | escape }}"
        class="image-banner__image"
      >
      <div class="image-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
    {%- else -%}
      <img src="{{ 'hero_banner.png' | asset_url }}"
        loading="eager"
        alt="Artisanal hero banner"
        class="image-banner__image"
      >
      <div class="image-banner__overlay" style="opacity: 0.1"></div>
    {%- endif -%}
  </div>

  <div class="image-banner__content page-width">
    <div class="image-banner__box">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="image-banner__heading h1" {{ block.shopify_attributes }}>
              {{ block.settings.heading | escape }}
            </h2>
          {%- when 'subheading' -%}
            <p class="image-banner__subheading h4" {{ block.shopify_attributes }}>
              {{ block.settings.subheading | escape }}
            </p>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button" {{ block.shopify_attributes }}>
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .image-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }
  .image-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .image-banner__image,
  .image-banner__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal-point, center center);
  }
  .image-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }
  .image-banner__content {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .image-banner__box {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 5rem;
    background-color: color-mix(in srgb, var(--color-background) 70%, transparent);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    color: var(--color-foreground);
    max-width: 800px;
  }
  .image-banner__heading {
    margin-bottom: 1rem;
  }
  .image-banner__subheading {
    margin-bottom: 2rem;
  }
</style>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 0,
      "unit": "%",
      "label": "Image overlay opacity"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "default": "Add a descriptive subheading",
          "label": "Subheading"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop now",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
