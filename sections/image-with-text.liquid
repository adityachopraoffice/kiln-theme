<div class="image-with-text color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="image-with-text__inner {% if section.settings.layout == 'text_first' %}image-with-text__inner--reverse{% endif %}">
      
      <div class="image-with-text__media-item">
        <div class="image-with-text__media {% if section.settings.organic_shape %}image-with-text__media--organic{% endif %}">
          {%- if section.settings.image != blank -%}
            <img srcset="{{ section.settings.image | image_url: width: 600 }} 1x, {{ section.settings.image | image_url: width: 1200 }} 2x"
              src="{{ section.settings.image | image_url: width: 600 }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | escape }}"
            >
          {%- else -%}
            <img src="{{ 'artisan_profile.png' | asset_url }}"
              loading="lazy"
              alt="Artisan Profile"
            >
          {%- endif -%}
        </div>
      </div>

      <div class="image-with-text__text-item">
        <div class="image-with-text__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="image-with-text__heading h2" {{ block.shopify_attributes }}>
                  {{ block.settings.heading | escape }}
                </h2>
              {%- when 'text' -%}
                <div class="image-with-text__text rte" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link }}" class="button" {{ block.shopify_attributes }}>
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .image-with-text {
    padding: var(--section-spacing) 0;
  }
  .image-with-text__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media screen and (min-width: 750px) {
    .image-with-text__inner {
      flex-direction: row;
      align-items: center;
    }
    .image-with-text__inner--reverse {
      flex-direction: row-reverse;
    }
    .image-with-text__media-item,
    .image-with-text__text-item {
      width: 50%;
    }
  }
  .image-with-text__media {
    position: relative;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.05);
  }
  .image-with-text__media img,
  .image-with-text__media svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-with-text__media--organic {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
  }
  .image-with-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .image-with-text__heading {
    margin-bottom: 1rem;
  }
  .image-with-text__text {
    margin-bottom: 2rem;
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop image placement",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Image second"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "organic_shape",
      "default": false,
      "label": "Use organic shape clip"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image with text",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
