<div class="main-page color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    <h1 class="main-page-title h1 text-center">
      {{ page.title | escape }}
    </h1>
    
    {%- if page.content != blank -%}
      <div class="main-page-content rte text-center">
        {{ page.content }}
      </div>
    {%- endif -%}

    <div class="contact-form">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message form__message--success" tabindex="-1" autofocus>
            {{ 'templates.contact.form.post_success' | t }}
          </h2>
        {%- elsif form.errors -%}
          <div class="form__message form__message--error">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              Please adjust the following:
            </h2>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </a>
              </li>
            </ul>
          </div>
        {%- endif -%}

        <div class="contact__fields">
          <div class="field">
            <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
            <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Name">
          </div>
          <div class="field field--with-error">
            <label class="field__label" for="ContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="Email"
              required
            >
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
          <input type="tel" id="ContactForm-phone" class="field__input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Phone number">
        </div>

        <div class="field">
          <label class="form__label field__label" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
          <textarea
            rows="10"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            placeholder="Comment"
          >
            {{- form.body -}}
          </textarea>
        </div>

        <div class="contact__button text-center">
          <button type="submit" class="button">
            {{ 'templates.contact.form.send' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .main-page {
    padding: var(--section-spacing) 0;
  }
  .page-width--narrow {
    max-width: 800px;
    margin: 0 auto;
  }
  .main-page-title {
    margin-bottom: 2rem;
    word-break: break-word;
  }
  .main-page-content {
    margin-bottom: 3rem;
    word-break: break-word;
  }
  .text-center {
    text-align: center;
  }
  
  .contact-form {
    margin-top: 3rem;
  }
  .contact__fields {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  @media screen and (min-width: 750px) {
    .contact__fields {
      flex-direction: row;
    }
    .contact__fields .field {
      flex: 1;
    }
  }
  .field {
    margin-bottom: 1.5rem;
  }
  .field__label {
    display: block;
    margin-bottom: 0.5rem;
  }
  .field__input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid rgba(var(--color-foreground), 0.5);
    background: transparent;
    color: inherit;
    border-radius: 4px;
  }
  .text-area {
    min-height: 150px;
    resize: vertical;
  }
  .contact__button {
    margin-top: 2rem;
  }
  .form__message {
    padding: 1rem;
    margin-bottom: 2rem;
    border-radius: 4px;
  }
  .form__message--error {
    background-color: rgba(200, 0, 0, 0.1);
    border: 1px solid red;
  }
  .form__message--success {
    background-color: rgba(0, 150, 0, 0.1);
    border: 1px solid green;
  }
</style>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ]
}
{% endschema %}
