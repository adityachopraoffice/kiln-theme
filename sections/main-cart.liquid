<div class="cart color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="cart__header">
      <h1 class="h2">{{ 'cart.general.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="cart__continue link">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    </div>

    {%- if cart != empty -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart__contents">
        <div class="cart__items">
          <table class="cart-items">
            <thead>
              <tr>
                <th colspan="2" scope="col">{{ 'cart.label.product' | t }}</th>
                <th scope="col">{{ 'cart.label.quantity' | t }}</th>
                <th scope="col">{{ 'cart.label.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                  <td class="cart-item__media">
                    {% if item.image %}
                      <a href="{{ item.url }}">
                        <img src="{{ item.image | image_url: width: 300 }}"
                          alt="{{ item.image.alt | escape }}"
                          loading="lazy"
                          width="150"
                          height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                        >
                      </a>
                    {% endif %}
                  </td>

                  <td class="cart-item__details">
                    <a href="{{ item.url }}" class="cart-item__name h4">{{ item.product.title | escape }}</a>
                    
                    {%- if item.original_price != item.final_price -%}
                      <div class="cart-item__discounted-prices">
                        <span class="visually-hidden">Regular price</span>
                        <s class="cart-item__old-price price price--end">{{ item.original_price | money }}</s>
                        <span class="visually-hidden">Sale price</span>
                        <span class="price price--end">{{ item.final_price | money }}</span>
                      </div>
                    {%- else -%}
                      <div class="product-option">{{ item.original_price | money }}</div>
                    {%- endif -%}

                    {%- if item.variant.unit_price_measurement -%}
                      <div class="unit-price caption" style="margin-top: 0.25rem;">
                        {{ item.variant.unit_price | money }} / 
                        {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                          {{- item.variant.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ item.variant.unit_price_measurement.reference_unit }}
                      </div>
                    {%- endif -%}

                    {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                      <dl>
                        {%- if item.product.has_only_default_variant == false -%}
                          {%- for option in item.options_with_values -%}
                            <div class="product-option">
                              <dt>{{ option.name }}: </dt>
                              <dd>{{ option.value }}</dd>
                            </div>
                          {%- endfor -%}
                        {%- endif -%}

                        {%- if item.selling_plan_allocation != nil -%}
                          <div class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</div>
                        {%- endif -%}
                      </dl>
                    {%- endif -%}

                    <a href="{{ item.url_to_remove }}" class="button button--secondary cart-item__remove" aria-label="{{ 'cart.general.remove' | t }}">
                      {{ 'cart.general.remove' | t }}
                    </a>
                  </td>

                  <td class="cart-item__quantity">
                    <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                      {{ 'cart.label.quantity' | t }}
                    </label>
                    <div class="quantity-input">
                      <button class="quantity-input__button" name="minus" type="button">-</button>
                      <input class="quantity-input__input"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        id="Quantity-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                      >
                      <button class="quantity-input__button" name="plus" type="button">+</button>
                    </div>
                  </td>

                  <td class="cart-item__totals">
                    <div class="cart-item__price-wrapper">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <dl class="cart-item__discounted-prices">
                          <dt class="visually-hidden">Regular price</dt>
                          <dd><s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s></dd>
                          <dt class="visually-hidden">Sale price</dt>
                          <dd><span class="price price--end">{{ item.final_line_price | money }}</span></dd>
                        </dl>
                      {%- else -%}
                        <span class="price price--end">{{ item.original_line_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        
        <div class="cart__footer">
          {%- if section.settings.show_cart_note -%}
            <div class="cart__note">
              <label for="Cart-note">{{ 'cart.general.note' | t }}</label>
              <textarea name="note" form="cart" id="Cart-note" class="text-area">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart__blocks">
            <div class="cart__blocks-content">
              <div class="cart__totals">
                <h3 class="h4">{{ 'cart.general.subtotal' | t }}</h3>
                <p class="cart__totals-price">{{ cart.total_price | money_with_currency }}</p>
              </div>
              
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <ul class="discounts list-unstyled" role="list">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <li class="discounts__discount">
                      {{ discount.title }} (-{{ discount.total_allocated_amount | money }})
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <small class="tax-note">
                {%- if cart.taxes_included -%}
                  {{ 'cart.general.taxes_inclusive' | t }}
                {%- else -%}
                  {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </small>
            </div>

            <div class="cart__ctas">
              <button type="submit" id="checkout" class="cart__checkout-button button" name="checkout" {% if cart == empty %}disabled{% endif %}>
                {{ 'cart.general.checkout' | t }}
              </button>
            </div>

            {%- if additional_checkout_buttons -%}
              <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart__empty">
        <h2 class="h3">{{ 'cart.general.empty' | t }}</h2>
        <a href="{{ routes.all_products_collection_url }}" class="button">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .cart {
    padding: var(--section-spacing) 0;
  }
  .cart__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
  }
  .cart-items {
    width: 100%;
    border-collapse: collapse;
  }
  .cart-items th {
    text-align: left;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .cart-items td {
    padding: 2rem 0;
    vertical-align: top;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .cart-item__media {
    width: 150px;
    padding-right: 2rem;
  }
  .cart-item__media img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .cart-item__name {
    text-decoration: none;
    margin: 0 0 0.5rem 0;
    display: block;
  }
  .product-option {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(var(--color-foreground), 0.8);
    margin: 0;
  }
  .product-option dt, .product-option dd {
    margin: 0;
  }
  .cart-item__remove {
    margin-top: 1rem;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
  }
  .cart-item__quantity {
    width: 150px;
  }
  .quantity-input {
    display: inline-flex;
    border: 1px solid var(--color-foreground);
    border-radius: 4px;
  }
  .quantity-input__button {
    background: transparent;
    border: none;
    padding: 0.5rem;
    color: inherit;
    cursor: pointer;
  }
  .quantity-input__input {
    width: 3rem;
    text-align: center;
    border: none;
    background: transparent;
    color: inherit;
    -moz-appearance: textfield;
  }
  .quantity-input__input::-webkit-outer-spin-button,
  .quantity-input__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .cart-item__totals {
    text-align: right;
    width: 100px;
  }
  
  .cart__footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 3rem;
  }
  @media screen and (min-width: 750px) {
    .cart__footer {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .cart__note {
    width: 100%;
    max-width: 300px;
  }
  .cart__note label {
    display: block;
    margin-bottom: 0.5rem;
  }
  .cart__note textarea {
    width: 100%;
    min-height: 100px;
    padding: 0.5rem;
    border: 1px solid var(--color-foreground);
    background: transparent;
    color: inherit;
  }
  .cart__blocks {
    width: 100%;
    max-width: 400px;
  }
  .cart__totals {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .cart__totals h3 {
    margin: 0;
  }
  .cart__totals-price {
    font-size: 1.5rem;
    margin: 0;
  }
  .tax-note {
    display: block;
    margin-bottom: 2rem;
    color: rgba(var(--color-foreground), 0.8);
  }
  .cart__checkout-button {
    width: 100%;
    margin-bottom: 1rem;
  }
  .cart__empty {
    text-align: center;
    padding: 4rem 0;
  }
  .cart__empty h2 {
    margin-bottom: 2rem;
  }
</style>

<script>
  document.querySelectorAll('.quantity-input__button').forEach((btn) => {
    btn.addEventListener('click', function() {
      const input = this.parentElement.querySelector('.quantity-input__input');
      let value = parseInt(input.value, 10);
      if (this.name === 'plus') {
        value++;
      } else {
        value = Math.max(0, value - 1);
      }
      input.value = value;
      document.getElementById('cart').submit();
    });
  });
  
  document.querySelectorAll('.quantity-input__input').forEach((input) => {
    input.addEventListener('change', function() {
      document.getElementById('cart').submit();
    });
  });
</script>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "default": true,
      "label": "Enable cart notes"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ]
}
{% endschema %}
