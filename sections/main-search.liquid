<div class="main-search color-scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="main-search__header">
      <h1 class="h1">
        {%- if search.performed -%}
          {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
        {%- else -%}
          {{ 'general.search.title' | t }}
        {%- endif -%}
      </h1>

      <div class="main-search__search-form">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
          <div class="search-form__input-wrapper">
            <input
              class="search-form__input field__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button class="search-form__button button" type="submit" aria-label="{{ 'general.search.search' | t }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" width="24" height="24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="main-search__no-results text-center">
          <p role="status">{{ 'general.search.no_results' | t }}</p>
        </div>
      {%- else -%}
        {%- paginate search.results by section.settings.results_per_page -%}
          <div class="main-search__results">
            <div class="search-toolbar" style="margin-bottom: 2rem;">
              <form id="FacetFiltersForm" class="search-toolbar__filters">
                <input type="hidden" name="q" value="{{ search.terms | escape }}">
                <input type="hidden" name="options[prefix]" value="last">
                <details class="facets__disclosure">
                  <summary class="facets__summary caption-large focus-offset" style="cursor: pointer; text-decoration: underline;">
                    <span>Filter Results</span>
                  </summary>
                  <div class="facets__display" style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1rem; padding: 1rem; background: rgba(var(--color-foreground), 0.05); border-radius: 4px;">
                    {%- for filter in search.filters -%}
                      <details class="facets__disclosure-inner">
                        <summary class="facets__summary-inner" style="cursor: pointer; font-weight: bold;">
                          <span>{{ filter.label }}</span>
                        </summary>
                        <div class="facets__display-inner" style="margin-top: 0.5rem;">
                          <ul class="facets__list list-unstyled" role="list">
                            {%- for value in filter.values -%}
                              <li class="list-menu__item facets__item">
                                <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}" style="cursor: pointer;">
                                    <input type="checkbox"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                      {% if value.active %}checked{% endif %}
                                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                    >
                                  {{ value.label | escape }} ({{ value.count }})
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </details>
                    {%- endfor -%}
                    <div style="width: 100%; margin-top: 1rem; border-top: 1px solid rgba(var(--color-foreground), 0.1); padding-top: 1rem;">
                      <button type="submit" class="button" style="width: 100%;">Apply Filters</button>
                    </div>
                  </div>
                </details>
              </form>
            </div>
            
            <div class="search-grid">
              {%- for item in search.results -%}
                <div class="search-grid__item">
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      <a href="{{ item.url }}" class="product-card">
                        <div class="product-card__image-wrapper">
                          {%- if item.featured_media -%}
                            <img srcset="{{ item.featured_media | image_url: width: 600 }} 1x, {{ item.featured_media | image_url: width: 1200 }} 2x"
                              src="{{ item.featured_media | image_url: width: 600 }}"
                              loading="lazy"
                              width="{{ item.featured_media.width }}"
                              height="{{ item.featured_media.height }}"
                              alt="{{ item.featured_media.alt | escape }}"
                              class="product-card__image"
                            >
                          {%- else -%}
                            <div class="product-card__placeholder">
                              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {%- endif -%}
                        </div>
                        <div class="product-card__info">
                          <h3 class="h5 product-card__title">{{ item.title }}</h3>
                          <div class="product-card__price">
                            <span class="price-item">{{ item.price | money }}</span>
                          </div>
                        </div>
                      </a>
                    {%- when 'article' -%}
                      <a href="{{ item.url }}" class="blog-card__link">
                        <div class="blog-card__image-wrapper">
                          {%- if item.image -%}
                            <img srcset="{{ item.image | image_url: width: 600 }} 1x, {{ item.image | image_url: width: 1200 }} 2x"
                              src="{{ item.image | image_url: width: 600 }}"
                              loading="lazy"
                              width="{{ item.image.width }}"
                              height="{{ item.image.height }}"
                              alt="{{ item.image.alt | escape }}"
                              class="blog-card__image"
                            >
                          {%- else -%}
                            <div class="blog-card__placeholder">
                              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {%- endif -%}
                        </div>
                        <div class="blog-card__info">
                          <h3 class="blog-card__title h5">{{ item.title }}</h3>
                          <span class="blog-card__read-more button button--secondary">{{ 'blogs.article.read_more' | t }}</span>
                        </div>
                      </a>
                    {%- when 'page' -%}
                      <a href="{{ item.url }}" class="page-card">
                        <div class="page-card__info">
                          <h3 class="h5">{{ item.title }}</h3>
                          <p class="caption">Page</p>
                        </div>
                      </a>
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              <ul class="pagination__list list-unstyled" role="list">
                {%- if paginate.previous -%}
                  <li>
                    <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev" aria-label="{{ 'general.pagination.previous' | t }}">
                      &larr; Prev
                    </a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                    {%- else -%}
                      {%- if part.title == paginate.current_page -%}
                        <span class="pagination__item pagination__item--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
                      {%- else -%}
                        <span class="pagination__item">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next" aria-label="{{ 'general.pagination.next' | t }}">
                      Next &rarr;
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<style>
  .main-search {
    padding: var(--section-spacing) 0;
  }
  .main-search__header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .main-search__search-form {
    max-width: 600px;
    margin: 0 auto;
  }
  .search-form__input-wrapper {
    display: flex;
    gap: 0.5rem;
  }
  .search-form__input {
    flex-grow: 1;
  }
  .search-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .search-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .product-card,
  .blog-card__link,
  .page-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .product-card__image-wrapper,
  .blog-card__image-wrapper {
    position: relative;
    padding-bottom: 125%; /* 4:5 */
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.05);
    margin-bottom: 1rem;
    border-radius: 4px;
  }
  .blog-card__image-wrapper {
    padding-bottom: 66%; /* 3:2 */
  }
  .product-card__image,
  .blog-card__image,
  .product-card__placeholder,
  .blog-card__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__title,
  .blog-card__title {
    margin: 0 0 0.5rem 0;
  }
  .page-card {
    padding: 2rem;
    background-color: rgba(var(--color-foreground), 0.05);
    border-radius: 4px;
    justify-content: center;
    text-align: center;
  }
  .page-card__info h3 {
    margin: 0 0 0.5rem 0;
  }
  
  .pagination__list {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 4rem;
    list-style: none;
    padding: 0;
  }
  .pagination__item {
    text-decoration: none;
    color: inherit;
  }
  .pagination__item--current {
    font-weight: bold;
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Results per page"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "clay",
          "label": "Clay"
        },
        {
          "value": "linen",
          "label": "Linen"
        },
        {
          "value": "ash",
          "label": "Ash"
        },
        {
          "value": "sage",
          "label": "Sage"
        }
      ],
      "default": "linen"
    }
  ]
}
{% endschema %}
